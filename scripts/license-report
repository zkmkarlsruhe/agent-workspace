#!/usr/bin/env python3
# SPDX-License-Identifier: MIT

"""Report the licences of all direct and indirect requirements in manager/go.mod."""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def json_stream(text):
    decoder = json.JSONDecoder()
    while text.strip():
        value, end = decoder.raw_decode(text.lstrip())
        yield value
        text = text.lstrip()[end:]


def detect(text):
    text = " ".join(text.lower().split())
    if re.search(r"\b(?:a?gpl|sspl)(?:[- ]v?\d|\b)|gnu (?:affero )?general public license|server side public license", text):
        raise ValueError("prohibited GPL/AGPL/SSPL licence")
    found = set()
    if "permission is hereby granted, free of charge" in text and "permission notice" in text:
        found.add("MIT")
    if "apache license" in text and ("version 2.0" in text or "license, version 2.0" in text):
        found.add("Apache-2.0")
    if "redistribution and use in source and binary forms" in text and "this software is provided" in text:
        found.add("BSD-3-Clause" if "neither the name" in text else "BSD-2-Clause")
    if "permission to use, copy, modify, and/or distribute this software" in text:
        found.add("ISC" if "copyright notice" in text else "0BSD")
    if "mozilla public license" in text and "2.0" in text:
        found.add("MPL-2.0")
    if "creative commons attribution 4.0 international" in text:
        found.add("CC-BY-4.0")
    if "attribution-sharealike 4.0 international" in text:
        found.add("CC-BY-SA-4.0")
    if "sqlite is public domain" in text:
        found.add("Public domain (SQLite)")
    if not found:
        raise ValueError("unknown or undetected licence")
    return sorted(found)


def module_licenses(directory):
    # Dependency inventories and artwork are not the module licence; retain their upstream notices.
    files = sorted(p for p in directory.iterdir() if p.is_file()
                   and p.name.lower().startswith(("license", "licence", "copying"))
                   and p.name not in {"LICENSE-LOGO", "LICENSE-3RD-PARTY.md"})
    if not files:
        raise ValueError(f"{directory.name}: no LICENSE/LICENCE/COPYING files in module cache")
    licenses = set()
    for path in files:
        try:
            licenses.update(detect(path.read_text(encoding="utf-8")))
        except ValueError as error:
            raise ValueError(f"{directory.name}/{path.name}: {error}") from error
    return "; ".join(sorted(licenses))


def report(root, go):
    def run(*args):
        return subprocess.check_output([go, *args], cwd=root / "manager", text=True)

    required = {m["Path"]: m["Version"] for m in json.loads(run("mod", "edit", "-json"))["Require"]}
    # -e keeps unrelated dependency test/tool metadata errors from hiding go.mod requirements.
    modules = list(json_stream(run("list", "-m", "-e", "-json", "all")))
    rows = []
    for module in modules:
        name = module["Path"]
        if name not in required:
            continue
        if module.get("Error") or not module.get("Dir") or module.get("Replace"):
            raise ValueError(f"{name}: missing module cache or unsupported replacement; run go mod download")
        if module["Version"] != required.pop(name):
            raise ValueError(f"{name}: selected version differs from go.mod")
        rows.append((name, module["Version"], module_licenses(Path(module["Dir"]))))
    if required:
        raise ValueError("modules missing from go list: " + ", ".join(sorted(required)))
    lines = ["# Third-party licences", "",
             "Generated by `scripts/license-report`; do not edit by hand.", "",
             "Every direct and indirect requirement in `manager/go.mod` is listed below.",
             "Licences are detected from LICENSE/LICENCE/COPYING files in the Go module cache.",
             "Multiple names retain separate upstream terms; they do not imply a choice of licence.",
             "Dependency-only test/tool modules outside this go.mod are not included.",
             "Upstream copyright and licence notices remain applicable; this report does not replace them.", "",
             "| Module | Version | Licence(s) |", "|---|---|---|"]
    lines.extend(f"| {name} | {version} | {licence} |" for name, version, licence in sorted(rows))
    htmx = (root / "manager/web/static/js/htmx.min.js").read_text()
    version = re.search(r'version:\s*"([\d.]+)"', htmx)
    if not version:
        raise ValueError("htmx version not detected")
    htmx_license = "; ".join(detect((root / "manager/web/static/js/htmx.LICENSE").read_text()))
    lines += ["", "## Bundled JavaScript", "", "| Asset | Version | Licence |", "|---|---|---|",
              f"| htmx | {version[1]} | {htmx_license} |", "", "## Example container bases and runtime", "",
              "These are separate distributions, not relicensed under MIT. Debian contains packages",
              "under multiple licences, including GPL/LGPL; preserve each package's notices and source obligations.",
              "Node.js is installed from Debian packages, not a separate Node image. Versions follow the Debian snapshot.",
              "This is a base/runtime inventory, not an inventory of every package in an image.", "",
              "| Component | Image/version | Licence(s) |", "|---|---|---|"]
    bases = set()
    for path in sorted((root / "deploy/example").rglob("*Dockerfile")):
        for base in re.findall(r"^FROM\s+(\S+)", path.read_text(), re.M):
            if base == "scratch":
                continue
            family = base.split(":", 1)[0]
            licenses = {"debian": "Various (including GPL, LGPL, BSD, MIT)",
                        "golang": "BSD-3-Clause (Go); various (Debian base)",
                        "node": "MIT (Node.js); bundled dependencies and base have separate licences"}
            if family not in licenses:
                raise ValueError(f"unknown base image: {base}")
            bases.add((family, base, licenses[family]))
    if not bases:
        raise ValueError("no example base images found")
    lines.extend(f"| {name} | {version} | {licence} |" for name, version, licence in sorted(bases))
    runtime = (root / "deploy/example/runtime/Dockerfile").read_text()
    if not re.search(r"\bnodejs\s+npm\b", runtime):
        raise ValueError("Node.js runtime packaging changed; review the image inventory")
    lines += ["| Node.js | Debian nodejs package | MIT; bundled dependencies have separate licences |", "",
              "Sources: [Debian package copyright](https://www.debian.org/legal/licenses/),",
              "[Go LICENSE](https://go.dev/LICENSE), [Node.js LICENSE](https://github.com/nodejs/node/blob/main/LICENSE).", ""]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--go", default=os.environ.get("GO", "go"))
    parser.add_argument("--output", type=Path, default=ROOT / "THIRD_PARTY_LICENSES.md")
    args = parser.parse_args()
    try:
        text = report(ROOT, args.go)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"license-report: {error}\n")
    args.output.write_text(text, encoding="utf-8")


if __name__ == "__main__":
    main()
