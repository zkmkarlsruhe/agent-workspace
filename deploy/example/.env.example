# Copy to .env (mode 0600). No real credentials belong in this file.
# Portal DNS name, without scheme/path; wildcard DNS and TLS must cover *.OC_DOMAIN.
OC_DOMAIN=apps.example.org
# Persistent identity namespace. Choose once; changing it needs an identity migration.
OC_IDENTITY_ISSUER=reference-authentik
# Local build tags; manager, dockerproxy and provision must use the same image.
# For a registry deployment replace these with your published repo@sha256 digest.
MANAGER_IMAGE=workspace-manager:local
RUNTIME_IMAGE=workspace-runtime:local
# Bootstrap tags: pull, record RepoDigests and replace with image@sha256 before use.
TRAEFIK_IMAGE=traefik:v3.7.15
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.8.5
# Keep the database major fixed; major upgrades need a database migration.
POSTGRES_IMAGE=postgres:16-alpine
SQUID_IMAGE=ubuntu/squid:6.13-25.04_edge
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
# Generate each of the next four independently; see docs/INSTALL.md.
# >=32 bytes; preserve with manager data across restarts and backups.
OC_MASTER_KEY=
# Persistent IdP signing/encryption key (openssl rand -hex 32).
AUTHENTIK_SECRET_KEY=
# PostgreSQL password (openssl rand -hex 32); changing env does not alter an existing DB.
POSTGRES_PASSWORD=
# Internal LiteLLM bearer key: sk- followed by openssl rand -hex 32.
LITELLM_MASTER_KEY=
# /admin/* needs this token; generate independently (openssl rand -hex 32).
OC_ADMIN_TOKEN=
# Existing upstream OpenAI-compatible endpoint INCLUDING /v1; reachable from Docker.
MODEL_API_BASE=https://models.example.org/v1
# Upstream credential, available only to LiteLLM; use a nonempty dummy for a keyless local API.
MODEL_API_KEY=
# LiteLLM provider prefix plus upstream model ID, e.g. openai/your-model.
# Requires streaming chat completions and tool calls. Both roles use this model.
MODEL_ID=openai/your-model
# Concurrent person containers; each currently has a 2 GiB RAM / 2 CPU limit.
OC_MAX_RUNNING=2
# Per-person daily EUR cap (instance timezone); 0 disables. Charges are estimates.
# OC_TIMEZONE=UTC # Optional IANA timezone override.
OC_COST_CAP_DAY_EUR=5.00
