[
  {
    "name": "office_status",
    "title": "Office status",
    "description": "Report all document bindings, capabilities and idle timeouts.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "office_documents",
    "title": "Open Office documents",
    "description": "List controlled Nextcloud Office tabs. Choose a tab explicitly.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "office_open",
    "title": "Bind Office document",
    "description": "Reuse an existing document or open a file in its own tab. The same file returns the same documentId. Other documents remain bound.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tabId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fileId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^\\d+$"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "office_read",
    "title": "Read Office content",
    "description": "Read Word text or an XLSX range. Does not modify the document or selection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Document binding returned by office_open."
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        }
      },
      "required": [
        "documentId"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "office_find",
    "title": "Find Word text",
    "description": "Find exact case-sensitive Word text. Returned match IDs identify concrete ranges, including duplicate text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Document binding returned by office_open."
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "documentId",
        "query"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "office_capture",
    "title": "Capture edit target",
    "description": "Capture an explicit range, search match or local selection. Remote mouse selections are not yet supported. Replaces the previous snapshot for this document.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Document binding returned by office_open."
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "local_selection"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "sheet": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "range": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "required": [
                "kind",
                "sheet",
                "range"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "match"
                },
                "matchId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "matchId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "collaborator_selection"
                },
                "collaboratorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "collaboratorId"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "documentId",
        "target"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "office_replace",
    "title": "Replace captured content",
    "description": "Replace a checked snapshot once. Never retry an uncertain write. persisted:false means server file persistence is unverified.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Document binding returned by office_open."
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "values": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32767
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        }
      },
      "required": [
        "documentId",
        "snapshotId"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "office_close",
    "title": "Close Office document",
    "description": "Release this document only. Close bridge-created tabs, detach external tabs. Keep the authenticated browser and other documents.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Document binding returned by office_open."
        }
      },
      "required": [
        "documentId"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]
